 311:Core/Src/main.c **** 			  xi = temp + x0;
 312:Core/Src/main.c **** 			  iter++;
 313:Core/Src/main.c **** 		  }
 314:Core/Src/main.c **** 		  mandelbrot_sum = mandelbrot_sum + iter;
