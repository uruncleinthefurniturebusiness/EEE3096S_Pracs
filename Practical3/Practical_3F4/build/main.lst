 323:Core/Src/main.c **** uint64_t calculate_mandelbrot_double(int width, int height, int max_iterations)
 324:Core/Src/main.c **** {
 325:Core/Src/main.c ****     uint64_t mandelbrot_sum = 0;
 326:Core/Src/main.c ****     //TODO: Complete the function implementation
 327:Core/Src/main.c **** 
 328:Core/Src/main.c ****     for (int y = 0; y < height; y++)
 329:Core/Src/main.c ****     {
 330:Core/Src/main.c ****     	for (int x = 0; x < width ; x++)
 331:Core/Src/main.c ****     	{
 332:Core/Src/main.c ****     		double x_0 = ((double)x/width)*3.5 - 2.5;
 333:Core/Src/main.c ****     		double y_0 = (double)y/height * 2.0 - 1.0;
 334:Core/Src/main.c **** 
 335:Core/Src/main.c ****     		double x_i = 0;
 336:Core/Src/main.c ****     		double y_i = 0;
 337:Core/Src/main.c ****     		int iteration = 0;
 338:Core/Src/main.c **** 
 339:Core/Src/main.c **** 
 340:Core/Src/main.c ****     		while (iteration < max_iterations)
 341:Core/Src/main.c ****     		{
 342:Core/Src/main.c **** 
 343:Core/Src/main.c ****     			double x_i_sq = x_i*x_i;
 344:Core/Src/main.c ****     			double y_i_sq = y_i*y_i;
 345:Core/Src/main.c **** 
 346:Core/Src/main.c ****     			if(x_i_sq + y_i_sq > 4.0)
 347:Core/Src/main.c ****     			{
 348:Core/Src/main.c ****     				break;
 349:Core/Src/main.c ****     			}
 350:Core/Src/main.c ****     			double temp  = x_i_sq - y_i_sq;
 351:Core/Src/main.c ****     			y_i = 2.0*x_i*y_i + y_0;
