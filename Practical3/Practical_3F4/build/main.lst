 296:Core/Src/main.c **** 		  float x0 = ((float)x / width) * 3.5f - 2.5f;
 297:Core/Src/main.c **** 		  float y0 = ((float)y / height) * 2.0f - 1.0f;
 298:Core/Src/main.c **** 		  float xi = 0.0f, yi = 0.0f;
