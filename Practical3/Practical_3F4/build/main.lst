 257:Core/Src/main.c **** 		  // Convert to fixed-point coordinates
 258:Core/Src/main.c **** 		  // x0 = (x/width) * 3.5 - 2.5
 259:Core/Src/main.c **** 		  int64_t x0 = ((int64_t)x * 3500000 / width) - 2500000;
 260:Core/Src/main.c **** 		  // y0 = (y/height) * 2.0 - 1.0
 261:Core/Src/main.c **** 		  int64_t y0 = ((int64_t)y * 2000000 / height) - 1000000;
