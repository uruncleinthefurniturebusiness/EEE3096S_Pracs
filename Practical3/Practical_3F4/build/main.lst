 254:Core/Src/main.c ****                   break;
 255:Core/Src/main.c ****               }
 256:Core/Src/main.c **** 
 257:Core/Src/main.c **** 
 258:Core/Src/main.c **** 			  int64_t temp = xi2-yi2;
 259:Core/Src/main.c **** 			  yi = (2*xi*yi)/SCALE+y0;
 260:Core/Src/main.c **** 			  xi = temp + x0;
 261:Core/Src/main.c **** 			  iter++;
 262:Core/Src/main.c **** 		  }
 263:Core/Src/main.c **** 		  mandelbrot_sum = mandelbrot_sum + iter;
 264:Core/Src/main.c **** 
 265:Core/Src/main.c **** 	  }
