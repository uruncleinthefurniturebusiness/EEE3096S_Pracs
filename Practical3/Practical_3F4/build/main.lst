 235:Core/Src/main.c **** uint64_t calculate_mandelbrot_fixed_point_arithmetic(int width, int height, int max_iterations){
 236:Core/Src/main.c ****   uint64_t mandelbrot_sum = 0;
 237:Core/Src/main.c ****     //TODO: Complete the function implementation
 238:Core/Src/main.c **** 
 239:Core/Src/main.c ****   for (int y = 0; y < height; y++){
 240:Core/Src/main.c **** 	  for (int x = 0; x < width; x++){
 241:Core/Src/main.c **** 		  // Convert to fixed-point coordinates
 242:Core/Src/main.c **** 		  // x0 = (x/width) * 3.5 - 2.5
 243:Core/Src/main.c **** 		  int64_t x0 = ((int64_t)x * 3500000 / width) - 2500000;
 244:Core/Src/main.c **** 		  // y0 = (y/height) * 2.0 - 1.0
 245:Core/Src/main.c **** 		  int64_t y0 = ((int64_t)y * 2000000 / height) - 1000000;
 246:Core/Src/main.c **** 		  int64_t xi = 0, yi =0;
 247:Core/Src/main.c **** 		  int iter = 0;
 248:Core/Src/main.c **** 
 249:Core/Src/main.c **** 		  while (iter< max_iterations){
 250:Core/Src/main.c **** 			  int64_t xi2 = (xi*xi)/SCALE;
 251:Core/Src/main.c **** 			  int64_t yi2 = (yi*yi)/SCALE;
 252:Core/Src/main.c **** 
