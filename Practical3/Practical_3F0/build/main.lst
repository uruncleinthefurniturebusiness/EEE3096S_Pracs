 146:Core/Src/main.c **** 
 147:Core/Src/main.c **** 	  		  end_time = HAL_GetTick();
 148:Core/Src/main.c **** 	  		  execution_time = end_time - start_time;
 149:Core/Src/main.c **** 
 150:Core/Src/main.c **** 	  		  uint32_t stop_cycles = TIM2->CNT;
 151:Core/Src/main.c **** 
 152:Core/Src/main.c **** 	  		  uint32_t cycle_diff = 0;
 153:Core/Src/main.c **** 
 154:Core/Src/main.c **** 	  		  if (stop_cycles < start_cycles) {
 155:Core/Src/main.c **** 	  		      // Handle timer overflow
 156:Core/Src/main.c **** 	  		      cycle_diff = (0xFFFFFFFF - start_cycles) + stop_cycles + 1;
 157:Core/Src/main.c **** 	  		  } else {
 158:Core/Src/main.c **** 	  		    // Normal case
 159:Core/Src/main.c **** 	  		      cycle_diff = stop_cycles - start_cycles;
 160:Core/Src/main.c **** 	  		  }
 161:Core/Src/main.c **** 
 162:Core/Src/main.c **** 
 163:Core/Src/main.c **** 	  		  double time_s = (double)cycle_diff / 48e6;
 164:Core/Src/main.c **** 	  		  double throughput = (double)(width[i] * height[i]) / time_s;
 165:Core/Src/main.c **** 
