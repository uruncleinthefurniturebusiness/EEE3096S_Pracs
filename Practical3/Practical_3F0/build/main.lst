 294:Core/Src/main.c **** uint64_t calculate_mandelbrot_double(int width, int height, int max_iterations)
 295:Core/Src/main.c **** {
 296:Core/Src/main.c ****     uint64_t mandelbrot_sum = 0;
 297:Core/Src/main.c ****     //TODO: Complete the function implementation
ARM GAS  C:\Users\joshr\AppData\Local\Temp\ccRL7GAr.s 			page 8


 298:Core/Src/main.c **** 
 299:Core/Src/main.c ****     for (int y = 0; y < height; y++)
 300:Core/Src/main.c ****     {
 301:Core/Src/main.c ****     	for (int x = 0; x < width ; x++)
 302:Core/Src/main.c ****     	{
 303:Core/Src/main.c ****     		double x_0 = ((double)x/width)*3.5 - 2.5;
 304:Core/Src/main.c ****     		double y_0 = (double)y/height * 2.0 - 1.0;
 305:Core/Src/main.c **** 
 306:Core/Src/main.c ****     		double x_i = 0;
 307:Core/Src/main.c ****     		double y_i = 0;
 308:Core/Src/main.c ****     		int iteration = 0;
 309:Core/Src/main.c **** 
 310:Core/Src/main.c **** 
 311:Core/Src/main.c ****     		while (iteration < max_iterations)
 312:Core/Src/main.c ****     		{
 313:Core/Src/main.c **** 
 314:Core/Src/main.c ****     			double x_i_sq = x_i*x_i;
 315:Core/Src/main.c ****     			double y_i_sq = y_i*y_i;
 316:Core/Src/main.c **** 
 317:Core/Src/main.c ****     			if(x_i_sq + y_i_sq > 4.0)
 318:Core/Src/main.c ****     			{
 319:Core/Src/main.c ****     				break;
 320:Core/Src/main.c ****     			}
 321:Core/Src/main.c ****     			double temp  = x_i_sq - y_i_sq;
 322:Core/Src/main.c ****     			y_i = 2.0*x_i*y_i + y_0;
 323:Core/Src/main.c **** 
 324:Core/Src/main.c ****     			x_i = temp + x_0;
 325:Core/Src/main.c **** 
 326:Core/Src/main.c ****     			iteration = iteration +1;
 327:Core/Src/main.c **** 
 328:Core/Src/main.c ****     		}
 329:Core/Src/main.c **** 
 330:Core/Src/main.c ****     		mandelbrot_sum = mandelbrot_sum + iteration;
 331:Core/Src/main.c **** 
 332:Core/Src/main.c ****     	}
 333:Core/Src/main.c ****     }
 334:Core/Src/main.c **** 
 335:Core/Src/main.c ****     return mandelbrot_sum;
 336:Core/Src/main.c **** }
