 112:Core/Src/main.c ****   /* --- Enable TIM2 as free-running cycle counter --- */
 113:Core/Src/main.c ****   __HAL_RCC_TIM2_CLK_ENABLE();
 114:Core/Src/main.c ****   TIM2->PSC = 0;                  // Prescaler = 0  -> 48 MHz tick
 115:Core/Src/main.c ****   TIM2->CNT = 0;                  // Clear counter
 116:Core/Src/main.c ****   TIM2->CR1 |= TIM_CR1_CEN;       // Start timer
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****   /* USER CODE END 2 */
 119:Core/Src/main.c **** 
 120:Core/Src/main.c ****   /* Infinite loop */
 121:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 122:Core/Src/main.c ****   while (1)
 123:Core/Src/main.c ****   {
 124:Core/Src/main.c **** 	  /* USER CODE END WHILE */
 125:Core/Src/main.c **** 
 126:Core/Src/main.c **** 	      /* USER CODE BEGIN 3 */
 127:Core/Src/main.c **** 	  	  //TODO: Visual indicator: Turn on LED0 to signal processing start
 128:Core/Src/main.c **** 	  	  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
 129:Core/Src/main.c **** 
 130:Core/Src/main.c **** 	  	  //TODO: Benchmark and Profile Performance
 131:Core/Src/main.c **** 	  	  const int num_sizes = sizeof(dim) / sizeof(dim[0]);
 132:Core/Src/main.c **** 
 133:Core/Src/main.c **** 	  	        // Arrays to hold results for viewing in debugger
 134:Core/Src/main.c **** 
 135:Core/Src/main.c **** 	  	  for (int i = 0; i < num_sizes; i++)
 136:Core/Src/main.c **** 	  	  {
 137:Core/Src/main.c **** 	  		  uint32_t start_cycles = TIM2->CNT;
 138:Core/Src/main.c **** 	  		  start_time = HAL_GetTick();
 139:Core/Src/main.c **** 
 140:Core/Src/main.c **** 	  		  check_sum = calculate_mandelbrot_double(dim[i], dim[i], MAX_ITER);
 141:Core/Src/main.c **** 
 142:Core/Src/main.c **** 	  		  end_time = HAL_GetTick();
 143:Core/Src/main.c **** 	  		  execution_time = end_time - start_time;
 144:Core/Src/main.c **** 
 145:Core/Src/main.c **** 	  		  uint32_t stop_cycles = TIM2->CNT;
 146:Core/Src/main.c **** 	  		  uint32_t cycle_diff = stop_cycles - start_cycles;
 147:Core/Src/main.c **** 
ARM GAS  C:\Users\joshr\AppData\Local\Temp\cctReDLt.s 			page 4


 148:Core/Src/main.c **** 	  		  double time_s = (double)cycle_diff / 48e6;
 149:Core/Src/main.c **** 	  		  double throughput = (double)(dim[i] * dim[i]) / time_s;
 150:Core/Src/main.c **** 
 151:Core/Src/main.c **** 	  		  checksums[i]     = check_sum;
 152:Core/Src/main.c **** 	  		  exec_times[i]    = execution_time;  // ms from HAL_GetTick()
 153:Core/Src/main.c **** 	  		  cycle_counts[i]  = cycle_diff;      // raw CPU cycles
 154:Core/Src/main.c **** 	  		  time_secs[i]     = time_s;          // seconds
 155:Core/Src/main.c **** 	  		  throughput_pxps[i] = throughput;    // pixels per second
 156:Core/Src/main.c **** 	  	  }
 157:Core/Src/main.c **** 
 158:Core/Src/main.c **** 	  	  //TODO: Keep the LEDs ON for 2s
 159:Core/Src/main.c **** 	  	  HAL_Delay(2000);
 160:Core/Src/main.c **** 	  	  //TODO: Turn OFF LEDs
 161:Core/Src/main.c **** 	  	  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
 162:Core/Src/main.c ****   }
