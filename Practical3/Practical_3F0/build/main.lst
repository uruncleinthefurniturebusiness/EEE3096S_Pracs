 291:Core/Src/main.c **** uint64_t calculate_mandelbrot_double(int width, int height, int max_iterations)
 292:Core/Src/main.c **** {
 293:Core/Src/main.c ****     uint64_t mandelbrot_sum = 0;
 294:Core/Src/main.c ****     //TODO: Complete the function implementation
 295:Core/Src/main.c **** 
 296:Core/Src/main.c ****     for (int y = 0; y < height; y++)
 297:Core/Src/main.c ****     {
