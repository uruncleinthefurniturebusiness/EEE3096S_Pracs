 298:Core/Src/main.c ****     	for (int x = 0; x < width ; x++)
 299:Core/Src/main.c ****     	{
 300:Core/Src/main.c ****     		double x_0 = ((double)x/width)*3.5 - 2.5;
 301:Core/Src/main.c ****     		double y_0 = (double)y/height * 2.0 - 1.0;
 302:Core/Src/main.c **** 
 303:Core/Src/main.c ****     		double x_i = 0;
 304:Core/Src/main.c ****     		double y_i = 0;
 305:Core/Src/main.c ****     		int iteration = 0;
 306:Core/Src/main.c **** 
 307:Core/Src/main.c **** 
 308:Core/Src/main.c ****     		while (iteration < max_iterations)
 309:Core/Src/main.c ****     		{
 310:Core/Src/main.c **** 
 311:Core/Src/main.c ****     			double x_i_sq = x_i*x_i;
 312:Core/Src/main.c ****     			double y_i_sq = y_i*y_i;
 313:Core/Src/main.c **** 
 314:Core/Src/main.c ****     			if(x_i_sq + y_i_sq > 4.0)
 315:Core/Src/main.c ****     			{
 316:Core/Src/main.c ****     				break;
 317:Core/Src/main.c ****     			}
 318:Core/Src/main.c ****     			double temp  = x_i_sq - y_i_sq;
 319:Core/Src/main.c ****     			y_i = 2.0*x_i*y_i + y_0;
 320:Core/Src/main.c **** 
 321:Core/Src/main.c ****     			x_i = temp + x_0;
 322:Core/Src/main.c **** 
 323:Core/Src/main.c ****     			iteration = iteration +1;
 324:Core/Src/main.c **** 
 325:Core/Src/main.c ****     		}
