ARM GAS  C:\Users\joshr\AppData\Local\Temp\cc8WiFl9.s 			page 4


 146:Core/Src/main.c **** 
 147:Core/Src/main.c **** 	  		  uint32_t stop_cycles = TIM2->CNT;
 148:Core/Src/main.c **** 
 149:Core/Src/main.c **** 	  		uint32_t cycle_diff = 0;
 150:Core/Src/main.c **** 
 151:Core/Src/main.c **** 	  		if (stop_cycles < start_cycles) {
 152:Core/Src/main.c **** 	  		    // Handle timer overflow
 153:Core/Src/main.c **** 	  		    cycle_diff = (0xFFFFFFFF - start_cycles) + stop_cycles + 1;
 154:Core/Src/main.c **** 	  		} else {
 155:Core/Src/main.c **** 	  		    // Normal case
 156:Core/Src/main.c **** 	  		    cycle_diff = stop_cycles - start_cycles;
 157:Core/Src/main.c **** 	  		}
 158:Core/Src/main.c **** 
 159:Core/Src/main.c **** 
 160:Core/Src/main.c **** 	  		  double time_s = (double)cycle_diff / 48e6;
 161:Core/Src/main.c **** 	  		  double throughput = (double)(width[i] * height[i]) / time_s;
 162:Core/Src/main.c **** 
