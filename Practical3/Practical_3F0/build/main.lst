 114:Core/Src/main.c ****   /* --- Enable TIM2 as free-running cycle counter --- */
 115:Core/Src/main.c ****   __HAL_RCC_TIM2_CLK_ENABLE();
 116:Core/Src/main.c ****   TIM2->PSC = 0;                  // Prescaler = 0  -> 48 MHz tick
 117:Core/Src/main.c ****   TIM2->CNT = 0;                  // Clear counter
 118:Core/Src/main.c ****   TIM2->CR1 |= TIM_CR1_CEN;       // Start timer
 119:Core/Src/main.c **** 
 120:Core/Src/main.c ****   /* USER CODE END 2 */
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****   /* Infinite loop */
 123:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 124:Core/Src/main.c ****   while (1)
 125:Core/Src/main.c ****   {
 126:Core/Src/main.c **** 	  /* USER CODE END WHILE */
 127:Core/Src/main.c **** 
 128:Core/Src/main.c **** 	      /* USER CODE BEGIN 3 */
 129:Core/Src/main.c **** 	  	  //TODO: Visual indicator: Turn on LED0 to signal processing start
 130:Core/Src/main.c **** 	  	  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
 131:Core/Src/main.c **** 
 132:Core/Src/main.c **** 	  	  //TODO: Benchmark and Profile Performance
 133:Core/Src/main.c **** 	  	  const int num_sizes = sizeof(dim) / sizeof(dim[0]);
 134:Core/Src/main.c **** 
 135:Core/Src/main.c **** 	  	        // Arrays to hold results for viewing in debugger
 136:Core/Src/main.c **** 
 137:Core/Src/main.c **** 	  	  for (int i = 0; i < num_sizes; i++)
 138:Core/Src/main.c **** 	  	  {
 139:Core/Src/main.c **** 	  		  uint32_t start_cycles = TIM2->CNT;
 140:Core/Src/main.c **** 	  		  start_time = HAL_GetTick();
 141:Core/Src/main.c **** 
 142:Core/Src/main.c **** 	  		  check_sum = calculate_mandelbrot_fixed_point_arithmetic(dim[i], dim[i], MAX_ITER);
 143:Core/Src/main.c **** 
 144:Core/Src/main.c **** 	  		  end_time = HAL_GetTick();
 145:Core/Src/main.c **** 	  		  execution_time = end_time - start_time;
 146:Core/Src/main.c **** 
 147:Core/Src/main.c **** 	  		  uint32_t stop_cycles = TIM2->CNT;
ARM GAS  C:\Users\Ebrahim\AppData\Local\Temp\cctA21Jv.s 			page 4


 148:Core/Src/main.c **** 	  		  uint32_t cycle_diff = stop_cycles - start_cycles;
 149:Core/Src/main.c **** 
 150:Core/Src/main.c **** 	  		  double time_s = (double)cycle_diff / 48e6;
 151:Core/Src/main.c **** 	  		  double throughput = (double)(dim[i] * dim[i]) / time_s;
 152:Core/Src/main.c **** 
 153:Core/Src/main.c **** 	  		  checksums[i]     = check_sum;
 154:Core/Src/main.c **** 	  		  exec_times[i]    = execution_time;  // ms from HAL_GetTick()
 155:Core/Src/main.c **** 	  		  cycle_counts[i]  = cycle_diff;      // raw CPU cycles
 156:Core/Src/main.c **** 	  		  time_secs[i]     = time_s;          // seconds
 157:Core/Src/main.c **** 	  		  throughput_pxps[i] = throughput;    // pixels per second
 158:Core/Src/main.c **** 	  	  }
 159:Core/Src/main.c **** 
 160:Core/Src/main.c **** 	  	  //TODO: Keep the LEDs ON for 2s
 161:Core/Src/main.c **** 	  	  HAL_Delay(2000);
 162:Core/Src/main.c **** 	  	  //TODO: Turn OFF LEDs
 163:Core/Src/main.c **** 	  	  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
 164:Core/Src/main.c ****   }
